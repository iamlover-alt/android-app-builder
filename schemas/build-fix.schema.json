{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BuildFix",
  "type": "object",
  "required": ["diagnosis", "patches"],
  "properties": {
    "diagnosis": {"type": "string"},
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "find", "replace"],
        "properties": {
          "path": {"type": "string"},
          "find": {"type": "string", "minLength": 1},
          "replace": {"type": "string"}
        }
      }
    }
  }
}
