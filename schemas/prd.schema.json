{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRD",
  "type": "object",
  "required": [
    "id",
    "app_name",
    "stories",
    "mvp_cut"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "app_name": {
      "type": "string"
    },
    "min_sdk": {
      "type": "integer"
    },
    "target_sdk": {
      "type": "integer",
      "minimum": 36
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "as_a",
          "i_want",
          "so_that",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "as_a": {
            "type": "string"
          },
          "i_want": {
            "type": "string"
          },
          "so_that": {
            "type": "string"
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Gherkin line"
            }
          }
        }
      }
    },
    "mvp_cut": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "story ids in MVP"
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "cold_start_ms": {
          "type": "integer"
        },
        "apk_mb": {
          "type": "number"
        }
      }
    }
  }
}
